<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:xsdlite:test" xmlns="urn:xsdlite:test"
           targetNamespace="urn:xsdlite:test" elementFormDefault="qualified">

  <xs:attributeGroup name="agVersion">
    <xs:attribute name="version" type="tVersion" use="required"/>
    <xs:attribute name="lang" type="xs:language"/>
    <xs:attributeGroup ref="agAudit"/>
  </xs:attributeGroup>
  <xs:attributeGroup name="agAudit">
    <xs:attribute name="revision" type="xs:unsignedByte" default="0"/>
    <xs:attribute name="checksum" type="tChecksum"/>
  </xs:attributeGroup>

  <xs:simpleType name="tVersion">
    <xs:restriction base="xs:string">
      <xs:pattern value="\d+\.\d+(\.\d+)?"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tChecksum">
    <xs:restriction base="xs:hexBinary">
      <xs:length value="4"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tTitle">
    <xs:restriction base="xs:normalizedString">
      <xs:minLength value="1"/>
      <xs:maxLength value="40"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tCode">
    <xs:restriction base="xs:token">
      <xs:pattern value="\p{Lu}[\p{Lu}\d]{1,5}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tSku">
    <xs:restriction base="xs:token">
      <!-- Consonants only before the hyphen: a class with a subtraction. -->
      <xs:pattern value="[a-z-[aeiou]]{2,4}-\d{3}"/>
      <xs:pattern value="LEGACY\w*"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tTag">
    <xs:restriction base="xs:string">
      <xs:pattern value="\i\c*"/>
      <xs:pattern value="#[^\s#]+"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tStatus">
    <xs:restriction base="xs:token">
      <xs:enumeration value="draft"/>
      <xs:enumeration value="published"/>
      <xs:enumeration value="withdrawn"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tColour">
    <xs:union memberTypes="tNamedColour">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="#[0-9a-fA-F]{6}"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:union>
  </xs:simpleType>
  <xs:simpleType name="tNamedColour">
    <xs:restriction base="xs:token">
      <xs:enumeration value="red"/>
      <xs:enumeration value="green"/>
      <xs:enumeration value="blue"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tSizes">
    <xs:restriction>
      <xs:simpleType>
        <xs:list itemType="tSize"/>
      </xs:simpleType>
      <xs:minLength value="1"/>
      <xs:maxLength value="4"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tSize">
    <xs:restriction base="xs:positiveInteger">
      <xs:maxInclusive value="60"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tPositive">
    <xs:restriction base="xs:double">
      <xs:minExclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tMoney">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:totalDigits value="8"/>
      <xs:fractionDigits value="2"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tIssued">
    <xs:restriction base="xs:date">
      <xs:minInclusive value="2000-01-01"/>
      <xs:maxExclusive value="2100-01-01"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="tNote" mixed="true">
    <xs:sequence>
      <xs:element name="em" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="tCategory">
    <xs:simpleContent>
      <xs:extension base="tTitle">
        <xs:attribute name="code" type="tCode" use="required"/>
        <xs:attribute name="since" type="xs:gYear"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:group name="gPricing">
    <xs:sequence>
      <xs:element name="price" type="tPrice"/>
      <xs:element name="discount" type="tDiscount" minOccurs="0"/>
    </xs:sequence>
  </xs:group>
  <xs:complexType name="tPrice">
    <xs:simpleContent>
      <xs:extension base="tMoney">
        <xs:attribute name="currency" use="required">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:length value="3"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="valid" type="xs:dateTime"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <!-- A restriction of simple content: a discount is a small price. -->
  <xs:complexType name="tDiscount">
    <xs:simpleContent>
      <xs:restriction base="tPrice">
        <xs:maxInclusive value="99.99"/>
        <xs:attribute name="valid" use="prohibited"/>
      </xs:restriction>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="tDimension">
    <xs:attribute name="axis" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:NMTOKEN">
          <xs:enumeration value="x"/>
          <xs:enumeration value="y"/>
          <xs:enumeration value="z"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="mm" type="xs:float" use="required"/>
    <xs:attribute name="tolerance" type="xs:duration"/>
  </xs:complexType>

  <!-- An abstract type and two derivations, one by extension, one by restriction. -->
  <xs:complexType name="tShape" abstract="true">
    <xs:sequence>
      <xs:element name="label" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="fill" type="tColour"/>
    <xs:attribute name="layer" type="xs:int" default="0"/>
  </xs:complexType>
  <xs:complexType name="tSquare">
    <xs:complexContent>
      <xs:extension base="tShape">
        <xs:sequence>
          <xs:element name="side" type="tPositive"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="tUnlabelledSquare">
    <xs:complexContent>
      <xs:restriction base="tSquare">
        <xs:sequence>
          <xs:element name="side" type="tPositive"/>
        </xs:sequence>
        <xs:attribute name="layer" use="prohibited"/>
      </xs:restriction>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="tSettings">
    <xs:all>
      <xs:element name="locale" type="xs:language"/>
      <xs:element name="timeout" type="xs:nonNegativeInteger" minOccurs="0"/>
      <xs:element name="retries" type="xs:byte" minOccurs="0"/>
      <xs:element name="started" type="xs:time" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="tPayload">
    <xs:sequence>
      <xs:element name="data" type="xs:base64Binary" minOccurs="0"/>
      <xs:any namespace="##local" processContents="skip" minOccurs="0" maxOccurs="2"/>
    </xs:sequence>
    <xs:attribute name="encoding" type="xs:anyURI"/>
  </xs:complexType>

  <xs:complexType name="tLink">
    <xs:attribute name="sku" type="tSku" use="required"/>
    <xs:attribute name="colour" type="tColour" use="required"/>
  </xs:complexType>
</xs:schema>
